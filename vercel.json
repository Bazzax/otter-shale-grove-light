{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "tanstack-start",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "redirects": [
    {
      "source": "/guides/packing-power-september",
      "destination": "/guides/packing-power",
      "permanent": true
    },
    {
      "source": "/guides/travel-desk-september",
      "destination": "/guides/travel-desk",
      "permanent": true
    },
    {
      "source": "/guides/flight-legal-power-bank-prime-sale",
      "destination": "/guides/power-bank-hand-luggage-uk",
      "permanent": true
    },
    {
      "source": "/guides/flight-legal-power-bank-prime-sale/",
